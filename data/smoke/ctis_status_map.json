{
  "schema_version": "wave1.ctis_status.v1",
  "source_of_truth": {
    "retrieve": "ctPublicStatusCode",
    "search": "ctStatus"
  },
  "do_not_use": [
    "retrieve.ctStatus"
  ],
  "notes": [
    "retrieve.ctStatus is APPLICATION status (string), not public trial status.",
    "search.ctStatus is the numeric public status code; it matches retrieve.ctPublicStatusCode.",
    "Never map public status from the retrieve.ctStatus string alone.",
    "Wave-1 may quarantine-all-CTIS-until-mapped for the universe filter, but must still store and assert on ctPublicStatusCode."
  ],
  "unmapped_policy": "quarantine_until_mapped",
  "wave1_universe_policy": "quarantine_all_ctis_until_mapped",
